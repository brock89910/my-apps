const maxCovers=Math.max(...counts.map(c=>c.covers),1);
const maxBookings=Math.max(...counts.map(c=>c.bookings),1);
bar.innerHTML=dates.map((date,i)=>{
const data=S.reservations[date]||{bookings:0,covers:0};
const score=(data.covers/maxCovers*0.6)+(data.bookings/maxBookings*0.4);
let cls='fc-normal',label='Normal',tip='';
if(!data.bookings&&!data.covers){cls='fc-quiet';label='Quiet';tip='Day off?';}
else if(score>0.8){cls='fc-very-busy';label='Packed';tip='All hands';}
else if(score>0.5){cls='fc-busy';label='Busy';tip='Full crew';}
else if(score<0.25){cls='fc-quiet';label='Light';tip='Day off?';}
const hasOff=S.restrictions.filter(r=>r.week===getWeekKey()).some(r=>
r.text.toLowerCase().includes(DAYS[i].toLowerCase())&&r.text.toLowerCase().includes('off')
);
return`<div class="fc-day ${cls}">
