<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OVERLOOK — OPS</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
--bg:      #0a0908;
--bg2:     #0f0e0c;
--surface: #141310;
--s2:      #1a1916;
--s3:      #201f1c;
--border:  #2a2925;
--border2: #353330;
--amber:   #e8a020;
--amber2:  #f5b93a;
--amber-d: rgba(232,160,32,0.12);
--amber-g: rgba(232,160,32,0.06);
--text:    #f0ead6;
--text2:   #a09880;
--text3:   #5a5648;
--red:     #d04828;
--red-d:   rgba(208,72,40,0.15);
--green:   #4a8a4a;
--green-l: #6ab86a;
--font-head: 'Barlow Condensed', sans-serif;
--font-body: 'Barlow', sans-serif;
--font-mono: 'JetBrains Mono', monospace;
--r: 4px;
}
body::after{
content:'';position:fixed;inset:0;pointer-events:none;z-index:9999;
background:repeating-linear-gradient(
0deg,
transparent,
transparent 2px,
rgba(0,0,0,0.03) 2px,
rgba(0,0,0,0.03) 4px
);
}
body{
background:var(--bg);color:var(--text);
font-family:var(--font-body);min-height:100vh;display:flex;
background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
}
aside{
width:220px;min-height:100vh;background:var(--surface);
border-right:1px solid var(--border);display:flex;flex-direction:column;
flex-shrink:0;position:sticky;top:0;height:100vh;
}
.brand{
padding:28px 20px 22px;
border-bottom:1px solid var(--border);
position:relative;overflow:hidden;
}
.brand::before{
content:'';position:absolute;left:0;top:0;width:3px;height:100%;
background:linear-gradient(180deg,var(--amber),transparent);
}
.brand .tag{
font-family:var(--font-mono);font-size:.58rem;color:var(--amber);
letter-spacing:.15em;text-transform:uppercase;margin-bottom:6px;
display:flex;align-items:center;gap:6px;
}
.brand .tag::before{content:'▶';font-size:.5rem}
.brand h1{
font-family:var(--font-head);font-size:1.9rem;font-weight:900;
color:var(--text);letter-spacing:.02em;line-height:.9;text-transform:uppercase;
}
.brand h1 span{color:var(--amber)}
.brand .sub{
font-family:var(--font-mono);font-size:.58rem;color:var(--text3);
margin-top:8px;letter-spacing:.1em;
}
nav{padding:16px 10px;display:flex;flex-direction:column;gap:1px;overflow-y:auto;flex:1}
.nav-sec{
font-family:var(--font-mono);font-size:.58rem;color:var(--text3);
letter-spacing:.12em;text-transform:uppercase;
padding:12px 10px 5px;
}
.ni{
display:flex;align-items:center;gap:10px;
padding:9px 10px;border-radius:var(--r);cursor:pointer;
font-family:var(--font-body);font-size:.82rem;font-weight:500;
color:var(--text2);transition:all .12s;border:1px solid transparent;
user-select:none;position:relative;
}
.ni:hover{background:var(--s2);color:var(--text);border-color:var(--border)}
.ni.on{
background:var(--amber-d);color:var(--amber);
border-color:rgba(232,160,32,.25);
}
.ni.on::before{
content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);
width:2px;height:60%;background:var(--amber);border-radius:0 2px 2px 0;
}
.ni .ico{width:16px;text-align:center;font-size:.85rem;flex-shrink:0}
.ni .lbl{flex:1}
.ni .dot{
width:5px;height:5px;border-radius:50%;
background:var(--amber);opacity:0;transition:opacity .12s;
}
.ni.on .dot{opacity:1}
.sidebar-foot{
padding:14px 16px;border-top:1px solid var(--border);
font-family:var(--font-mono);font-size:.6rem;color:var(--text3);
display:flex;flex-direction:column;gap:4px;
}
.status-dot{
display:inline-block;width:6px;height:6px;border-radius:50%;
background:var(--green-l);margin-right:5px;
box-shadow:0 0 6px var(--green-l);animation:pulse 2s infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
main{flex:1;padding:28px 30px;overflow-y:auto;position:relative}
.topbar{
display:flex;align-items:center;justify-content:space-between;
margin-bottom:24px;padding-bottom:16px;
border-bottom:1px solid var(--border);
}
.topbar-left h2{
font-family:var(--font-head);font-size:2.2rem;font-weight:900;
text-transform:uppercase;letter-spacing:.03em;line-height:1;
color:var(--text);
}
.topbar-left .breadcrumb{
font-family:var(--font-mono);font-size:.6rem;color:var(--text3);
margin-bottom:4px;letter-spacing:.1em;
}
.topbar-right{
font-family:var(--font-mono);font-size:.65rem;color:var(--text2);
text-align:right;line-height:1.6;
}
.pg{display:none;animation:fadeIn .18s ease}.pg.on{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:10px;margin-bottom:22px}
.sc{
background:var(--surface);border:1px solid var(--border);
border-radius:var(--r);padding:16px 18px;position:relative;overflow:hidden;
transition:border-color .15s;
}
.sc:hover{border-color:var(--border2)}
.sc::after{
content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
background:linear-gradient(90deg,transparent,var(--amber-d),transparent);
}
.sc .lb{
font-family:var(--font-mono);font-size:.6rem;color:var(--text3);
text-transform:uppercase;letter-spacing:.1em;
}
.sc .vl{
font-family:var(--font-head);font-size:2rem;font-weight:800;
color:var(--amber);margin-top:4px;letter-spacing:.02em;line-height:1;
}
.sc .sb{font-size:.71rem;color:var(--text3);margin-top:3px}
.pn{
background:var(--surface);border:1px solid var(--border);
border-radius:var(--r);padding:20px;margin-bottom:14px;
position:relative;
}
.pn::before{
content:'';position:absolute;top:0;left:0;right:0;height:1px;
background:linear-gradient(90deg,var(--amber-d),transparent);
}
.pnh{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:8px;flex-wrap:wrap}
.pnh h3{
font-family:var(--font-head);font-size:1.1rem;font-weight:700;
text-transform:uppercase;letter-spacing:.06em;color:var(--text);
}
.btn{
display:inline-flex;align-items:center;gap:6px;
padding:7px 14px;border-radius:var(--r);
font-family:var(--font-body);font-size:.78rem;font-weight:600;
cursor:pointer;border:none;transition:all .12s;
text-transform:uppercase;letter-spacing:.05em;
}
.bg{background:var(--amber);color:#0a0908}.bg:hover{background:var(--amber2);transform:translateY(-1px);box-shadow:0 4px 16px rgba(232,160,32,.25)}
.bo{background:transparent;color:var(--text2);border:1px solid var(--border)}.bo:hover{border-color:var(--amber);color:var(--amber)}
.br{background:transparent;color:var(--red);border:1px solid rgba(208,72,40,.25)}.br:hover{background:var(--red-d)}
.bs{padding:4px 10px;font-size:.71rem}
.bg-s{
background:rgba(74,138,74,.15);color:var(--green-l);
border:1px solid rgba(74,138,74,.3);font-size:.71rem;padding:4px 10px;
border-radius:var(--r);cursor:pointer;font-family:var(--font-body);
font-weight:600;text-transform:uppercase;letter-spacing:.04em;transition:all .12s;
}
.bg-s:hover{background:rgba(74,138,74,.28)}
.fg{display:flex;flex-direction:column;gap:5px}
.fg label{
font-family:var(--font-mono);font-size:.6rem;color:var(--text3);
text-transform:uppercase;letter-spacing:.09em;
}
.fg input,.fg select,.fg textarea{
background:var(--s2);border:1px solid var(--border);
color:var(--text);border-radius:var(--r);padding:8px 10px;
font-size:.82rem;font-family:var(--font-body);outline:none;
transition:border-color .12s,background .12s;width:100%;
}
.fg input:focus,.fg select:focus,.fg textarea:focus{
border-color:var(--amber);background:var(--s3);
}
.fg input::placeholder{color:var(--text3)}
.fg select option{background:var(--s2);color:var(--text)}
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:10px;margin-bottom:14px}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th{
text-align:left;font-family:var(--font-mono);font-size:.62rem;
color:var(--text3);text-transform:uppercase;letter-spacing:.09em;
padding:8px 10px;border-bottom:1px solid var(--border);font-weight:500;
white-space:nowrap;
}
td{
padding:9px 10px;font-size:.8rem;
border-bottom:1px solid rgba(42,41,37,.6);vertical-align:middle;
}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(232,160,32,.03)}
.emp{
text-align:center;padding:30px;
font-family:var(--font-mono);font-size:.72rem;color:var(--text3);
letter-spacing:.05em;
}
.badge{
display:inline-block;padding:2px 8px;border-radius:2px;
font-family:var(--font-mono);font-size:.62rem;font-weight:500;
letter-spacing:.06em;text-transform:uppercase;
}
.bpaid{background:rgba(74,138,74,.2);color:var(--green-l)}
.bunpaid{background:rgba(208,72,40,.15);color:#e87858}
.bauto{background:rgba(74,122,155,.2);color:#7ab4cc}
.bmanual{background:var(--amber-d);color:var(--amber)}
.brole{background:rgba(74,122,155,.2);color:#7ab4cc}
.bdue{
background:rgba(208,72,40,.2);color:#e87858;
font-size:.6rem;padding:1px 5px;border-radius:2px;margin-left:5px;
font-family:var(--font-mono);
}
.rtag-freq{
display:inline-block;padding:2px 7px;border-radius:2px;
font-family:var(--font-mono);font-size:.6rem;
background:var(--s3);color:var(--text3);border:1px solid var(--border);
}
.aib{
background:var(--bg2);border:1px solid var(--border);
border-left:2px solid var(--amber);
border-radius:var(--r);padding:14px 16px;margin-bottom:14px;
}
.aib h4{
font-family:var(--font-mono);font-size:.68rem;color:var(--amber);
margin-bottom:6px;letter-spacing:.08em;text-transform:uppercase;
}
.aib p{font-size:.78rem;color:var(--text2);line-height:1.6}
.aip{
background:var(--bg);border:1px solid var(--border);
border-radius:var(--r);padding:12px;margin-top:10px;
font-family:var(--font-mono);font-size:.72rem;color:var(--text2);
line-height:1.75;white-space:pre-wrap;word-break:break-word;
}
.sch-tabs{
display:flex;gap:0;margin-bottom:14px;
border:1px solid var(--border);border-radius:var(--r);
overflow:hidden;width:fit-content;
}
.sch-tab{
padding:8px 22px;cursor:pointer;
font-family:var(--font-head);font-size:.88rem;font-weight:700;
color:var(--text2);transition:all .12s;user-select:none;
text-transform:uppercase;letter-spacing:.07em;
border-right:1px solid var(--border);
}
.sch-tab:last-child{border-right:none}
.sch-tab:hover{background:var(--s2);color:var(--text)}
.sch-tab.on{background:var(--amber);color:#0a0908}
.sch-tab-pane{display:none}.sch-tab-pane.on{display:block}
.sg-wrap{overflow-x:auto}
.sg{border-collapse:collapse;width:100%;min-width:640px}
.sg th{
background:var(--s3);
font-family:var(--font-head);font-size:.78rem;font-weight:800;
text-transform:uppercase;letter-spacing:.08em;
padding:9px 8px;border:1px solid var(--border);text-align:center;
color:var(--amber);
}
.sg th.corner{background:var(--bg2)}
.sg td{
border:1px solid var(--border);padding:5px 4px;
vertical-align:top;min-width:78px;background:var(--surface);
}
.sg td.section-cell{
background:var(--s3);
font-family:var(--font-head);font-size:.8rem;font-weight:800;
text-transform:uppercase;letter-spacing:.08em;text-align:center;
color:var(--amber);padding:8px 6px;white-space:nowrap;
}
.sg td.date-num{
background:var(--bg2);
font-family:var(--font-mono);font-size:.68rem;color:var(--text3);
text-align:center;padding:4px;border:1px solid var(--border);
}
.sg-chip{
background:var(--amber-g);border:1px solid rgba(232,160,32,.15);
border-radius:2px;padding:4px 5px;margin-bottom:3px;
font-size:.72rem;display:flex;justify-content:space-between;
align-items:center;gap:3px;cursor:default;
transition:border-color .1s;
}
.sg-chip:hover{border-color:rgba(232,160,32,.35)}
.sg-chip .cn{color:var(--amber);font-weight:600;font-family:var(--font-body)}
.sg-chip .ct{color:var(--text2);font-family:var(--font-mono);font-size:.65rem}
.sg-chip .cx{
background:none;border:none;color:var(--text3);cursor:pointer;
font-size:.65rem;padding:0;flex-shrink:0;transition:color .1s;
}
.sg-chip .cx:hover{color:var(--red)}
.sg-add{
font-family:var(--font-mono);font-size:.62rem;color:var(--text3);
padding:3px;cursor:pointer;border:1px dashed var(--border);
border-radius:2px;text-align:center;transition:all .1s;margin-top:2px;
}
.sg-add:hover{border-color:var(--amber);color:var(--amber)}
.week-lbl{
font-family:var(--font-head);font-size:1rem;font-weight:700;
color:var(--amber);text-transform:uppercase;letter-spacing:.04em;
}
.rbox{
background:var(--bg2);border:1px solid var(--border);
border-radius:var(--r);padding:12px;margin-bottom:12px;
}
.rbox h4{
font-family:var(--font-mono);font-size:.6rem;color:var(--text3);
margin-bottom:8px;text-transform:uppercase;letter-spacing:.1em;
}
.rlist{display:flex;flex-wrap:wrap;gap:5px}
.rtag{
display:inline-flex;align-items:center;gap:4px;
background:rgba(208,72,40,.1);border:1px solid rgba(208,72,40,.2);
color:#e87858;border-radius:2px;padding:3px 8px;
font-family:var(--font-mono);font-size:.68rem;
}
.rtag button{background:none;border:none;color:#e87858;cursor:pointer;font-size:.65rem;padding:0}
.forecast-bar{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:14px}
.fc-day{
border-radius:var(--r);padding:9px 6px;text-align:center;
border:1px solid var(--border);position:relative;
transition:border-color .12s;
}
.fc-day .fcd{font-family:var(--font-mono);font-size:.6rem;color:var(--text3);letter-spacing:.08em;text-transform:uppercase}
.fc-day .fcn{font-size:.78rem;font-weight:500;margin:2px 0;font-family:var(--font-mono)}
.fc-day .fcs{font-family:var(--font-mono);font-size:.62rem;text-transform:uppercase;letter-spacing:.06em}
.fc-day .fcc{font-size:.6rem;color:var(--text3);margin-top:1px;font-family:var(--font-mono)}
.fc-quiet{background:rgba(74,138,74,.06);border-color:rgba(74,138,74,.2)}.fc-quiet .fcs{color:var(--green-l)}
.fc-normal{background:var(--s2)}.fc-normal .fcs{color:var(--text2)}
.fc-busy{background:rgba(232,160,32,.06);border-color:rgba(232,160,32,.2)}.fc-busy .fcs{color:var(--amber)}
.fc-very-busy{background:rgba(208,72,40,.07);border-color:rgba(208,72,40,.25)}.fc-very-busy .fcs{color:#e87858}
.off-badge{
position:absolute;top:3px;right:3px;
background:rgba(74,138,74,.2);color:var(--green-l);
border-radius:2px;font-family:var(--font-mono);font-size:.55rem;
padding:1px 4px;letter-spacing:.06em;
}
.cpools{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.pbox{
background:var(--bg2);border:1px solid var(--border);
border-radius:var(--r);padding:16px;text-align:center;position:relative;overflow:hidden;
}
.pbox::before{
content:'';position:absolute;top:0;left:20%;right:20%;height:1px;
background:linear-gradient(90deg,transparent,var(--amber-d),transparent);
}
.pbox .pl{font-family:var(--font-mono);font-size:.62rem;color:var(--text3);text-transform:uppercase;letter-spacing:.1em}
.pbox .pv{font-family:var(--font-head);font-size:1.9rem;font-weight:800;color:var(--amber);margin-top:5px}
.pbox .ps{font-family:var(--font-mono);font-size:.65rem;color:var(--text2);margin-top:3px}
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:8px;margin-top:12px}
.pcard{
background:var(--bg2);border:1px solid var(--border);
border-radius:var(--r);padding:11px;
transition:border-color .12s;
}
.pcard:hover{border-color:var(--border2)}
.pcard .pname{font-family:var(--font-head);font-size:.95rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.pcard .prole{font-family:var(--font-mono);font-size:.6rem;color:var(--text3);margin-bottom:7px;text-transform:uppercase;letter-spacing:.07em}
.pcard .pamt{font-family:var(--font-head);font-size:1.2rem;font-weight:700;color:var(--amber);margin-top:5px}
.cls-title{
font-family:var(--font-head);font-size:1rem;font-weight:800;
text-transform:uppercase;letter-spacing:.07em;color:var(--amber);
margin-bottom:10px;padding-bottom:8px;
border-bottom:1px solid var(--border);
display:flex;align-items:center;gap:8px;
}
.cls-title::before{content:'//';font-family:var(--font-mono);font-size:.7rem;color:var(--text3)}
.ci{
display:flex;align-items:flex-start;gap:10px;
padding:8px 0;border-bottom:1px solid rgba(42,41,37,.4);
}
.ci:last-child{border-bottom:none}
.ci input[type=checkbox]{
width:15px;height:15px;accent-color:var(--amber);
cursor:pointer;flex-shrink:0;margin-top:2px;
}
.ci label{font-size:.81rem;cursor:pointer;flex:1;line-height:1.45;transition:color .12s}
.ci label.done{text-decoration:line-through;color:var(--text3)}
.ca{
font-family:var(--font-mono);font-size:.58rem;color:var(--text3);
background:var(--s3);padding:2px 6px;border-radius:2px;flex-shrink:0;
margin-top:2px;text-transform:uppercase;letter-spacing:.07em;
border:1px solid var(--border);
}
.ptot{
background:var(--amber-g);border:1px solid rgba(232,160,32,.2);
border-radius:var(--r);padding:12px 16px;
display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;
}
.ptot span{font-family:var(--font-mono);font-size:.65rem;color:var(--text2);text-transform:uppercase;letter-spacing:.08em}
.ptot strong{font-family:var(--font-head);font-size:1.7rem;font-weight:800;color:var(--amber)}
.copy-out{
background:var(--bg);border:1px solid var(--border);border-radius:var(--r);
padding:10px 12px;font-family:var(--font-mono);font-size:.74rem;
color:var(--text);white-space:pre;margin-top:10px;cursor:pointer;
transition:border-color .12s;user-select:all;overflow-x:auto;line-height:1.7;
}
.copy-out:hover{border-color:var(--amber)}
.pay-quick{display:grid;grid-template-columns:repeat(auto-fill,minmax(192px,1fr));gap:8px}
.pay-card{
background:var(--bg2);border:1px solid var(--border);
border-radius:var(--r);padding:11px;display:flex;flex-direction:column;gap:7px;
transition:border-color .12s;
}
.pay-card:hover{border-color:var(--border2)}
.pay-card .pcname{font-family:var(--font-head);font-size:.95rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.pay-card .pcrole{font-family:var(--font-mono);font-size:.6rem;color:var(--text3);text-transform:uppercase;letter-spacing:.07em}
.pay-card .pctot{font-family:var(--font-head);font-size:1.1rem;font-weight:700;color:var(--amber)}
.print-reminder{
background:rgba(208,72,40,.06);border:1px solid rgba(208,72,40,.2);
border-radius:var(--r);padding:9px 14px;
display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px;
}
.print-reminder span{font-size:.79rem;color:#e87858}
.print-reminder .prn{font-weight:600;color:var(--text)}
.sheet-preview{
background:var(--bg);border:1px solid var(--border);
border-radius:var(--r);overflow:auto;margin-top:12px;
}
.sheet-table{border-collapse:collapse;font-family:var(--font-body);font-size:.79rem;width:100%}
.sheet-table th,.sheet-table td{border:1px solid #2a2925;padding:5px 10px;white-space:nowrap}
.sheet-table th{
background:#161412;font-family:var(--font-head);font-size:.72rem;
font-weight:700;text-transform:uppercase;letter-spacing:.07em;
color:var(--amber);text-align:center;
}
.sheet-table td{background:#111010;color:var(--text);text-align:center}
