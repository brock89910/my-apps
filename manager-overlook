- Format: Name + time (e.g. "Kim 11", "Yang 1/2")
- "11-2" = 11am to 2pm shift
CURRENT SCHEDULE:
${currentSched}
RESERVATION FORECAST:
${forecastLines}
RESTRICTIONS:
${restrictions}
Suggest any changes needed. Consider giving staff the day off on quiet days. Keep schedule stable otherwise. Format as SUSHI / KITCHEN / SERVING rows, MON–SUN columns.`;
document.getElementById('sch-prompt-txt').textContent=p;
document.getElementById('sch-prompt-pn').style.display='block';
showToast('Prompt ready ✓');
};
// ── COUNTER ──
window.calcCounter=function(){
const tot=+document.getElementById('ct-tot').value||0;
const fh=+document.getElementById('ct-fh').value||0;
const kh=+document.getElementById('ct-kh').value||0;
const fp=+document.getElementById('ct-fp').value||70;
const kp=+document.getElementById('ct-kp').value||30;
const fpool=tot*(fp/100),kpool=tot*(kp/100);
const frate=fh?fpool/fh:0,krate=kh?kpool/kh:0;
document.getElementById('ct-fpool').textContent=fmt(fpool);
document.getElementById('ct-kpool').textContent=fmt(kpool);
document.getElementById('ct-frate').textContent=fmt(frate)+' / hr';
document.getElementById('ct-krate').textContent=fmt(krate)+' / hr';
updatePeopleCalc(frate,krate);
};
function buildCounterPeople(){
const c=document.getElementById('ct-people');
if(!S.payrollStaff.length){c.innerHTML='<p style="font-family:var(--font-mono);font-size:.67rem;color:var(--text3)">Add staff in Payroll first.</p>';return;}
c.innerHTML=S.payrollStaff.map(s=>`
<div class="pcard">
<div class="pname">${s.name}</div>
<div class="prole">${s.role}</div>
<div class="fg"><label>Hours today</label><input type="number" id="cth-${s.id}" placeholder="0" step="0.5" oninput="calcCounter()"></div>
<div class="pamt" id="cte-${s.id}">$0.00</div>
</div>`).join('');
}
function updatePeopleCalc(fr,kr){
S.payrollStaff.forEach(s=>{
const h=+document.getElementById('cth-'+s.id)?.value||0;
const el=document.getElementById('cte-'+s.id);
if(el)el.textContent=fmt(h*(s.role==='Cook'?kr:fr));
});
}
window.saveCounter=async function(){
const tot=+document.getElementById('ct-tot').value||0;
if(!tot){showToast('Enter total amount');return;}
const rec={date:document.getElementById('ct-date').value,total:tot,
fpool:document.getElementById('ct-fpool').textContent,
kpool:document.getElementById('ct-kpool').textContent,
frate:document.getElementById('ct-frate').textContent,
krate:document.getElementById('ct-krate').textContent};
rec.id=await fsAdd('counter',rec);S.counter.push(rec);renderCounter();showToast('Saved ✓');
};
function renderCounter(){
const sorted=[...S.counter].sort((a,b)=>new Date(b.date)-new Date(a.date));
document.getElementById('ct-tbody').innerHTML=sorted.length
?sorted.map(t=>`<tr>
<td>${t.date}</td><td style="color:var(--amber)">${fmt(t.total)}</td>
<td>${t.fpool}</td><td>${t.kpool}</td>
<td style="color:var(--text2)">${t.frate}</td>
<td style="color:var(--text2)">${t.krate}</td>
<td><button class="btn br bs" onclick="delCounter('${t.id}')">✕</button></td>
</tr>`).join('')
:`<tr><td colspan="7" class="emp">// No records yet</td></tr>`;
}
window.delCounter=async function(id){await fsDel('counter',id);S.counter=S.counter.filter(t=>t.id!==id);renderCounter();};
// ── CLEANING ──
const DAILY_TASKS=[
['✦ Confirm next day Reservations',''],
['Laundry — Wash & Hang',''],
['Stock up: To-go boxes / paper bags','FOH'],
['Stock up: Soy / Ginger / Wasabi','BOH'],
['Stock up: Soft drinks / Sodas','BAR'],
['Stock up: Sauces (salad dressing, ponzu, sweet chili, etc.)','BOH'],
['Stock up: Cup washer liquids','BOH'],
['Stock up: Beers / Wines / Liquors','BAR'],
['Stock up: Rice bowls / Saucers','BOH'],
["Check toilet paper & paper towels — Men's washroom",'ALL'],
["Check toilet paper & paper towels — Women's washroom",'ALL'],
['Chopsticks / Napkins refill — both stations','FOH'],
['Sanitizer box — check & refill','ALL'],
['Wipe menus & chairs — Dining + Teppan','FOH'],
['Wipe wine glasses','BAR'],
['Deep clean cup washer','BOH'],
['Deep clean bar — under sink area','BAR'],
['Deep clean bar — fridge under tap beers','BAR'],
['Deep clean bar — empty dirty beer containers','BAR'],
['Stock up wines (Pinot, Chardonnay, etc.)','BAR'],
];
function buildCleaning(){
document.getElementById('cl-daily').innerHTML=DAILY_TASKS.map(([t,a],i)=>`
<div class="ci">
<input type="checkbox" id="cl-${i}" onchange="this.nextElementSibling.classList.toggle('done',this.checked)">
<label for="cl-${i}">${t}</label>
${a?`<span class="ca">${a}</span>`:''}
</div>`).join('');
}
window.resetChecks=function(){
document.querySelectorAll('.ci input[type=checkbox]').forEach(cb=>{cb.checked=false;cb.nextElementSibling.classList.remove('done');});
};
window.saveChecklist=async function(){
const date=document.getElementById('cl-date').value;
const staff=document.getElementById('cl-staff').value.trim();
if(!date||!staff){showToast('Enter date and staff name');return;}
const all=document.querySelectorAll('.ci input[type=checkbox]');
const done=[...all].filter(c=>c.checked).length;
const rec={date,staff,done,total:all.length,pct:Math.round((done/all.length)*100)};
rec.id=await fsAdd('cleanLogs',rec);S.cleanLogs.push(rec);
renderCleanLog();showToast(`Saved — ${rec.pct}% ✓`);
};
function renderCleanLog(){
const sorted=[...S.cleanLogs].sort((a,b)=>new Date(b.date)-new Date(a.date));
document.getElementById('cl-log').innerHTML=sorted.length
?sorted.map(l=>{
const col=l.pct>=80?'var(--green-l)':l.pct>=50?'var(--amber)':'var(--red)';
return`<tr><td>${l.date}</td><td>${l.staff}</td><td>${l.done}</td><td>${l.total}</td><td style="color:${col};font-weight:600;font-family:var(--font-mono)">${l.pct}%</td></tr>`;
}).join('')
:`<tr><td colspan="5" class="emp">// No logs yet</td></tr>`;
}
// ── PAYROLL ──
window.addWageStaff=async function(){
const name=document.getElementById('wm-name').value.trim();
if(!name){showToast('Enter a name');return;}
const s={name,role:document.getElementById('wm-role').value,type:document.getElementById('wm-type').value,wage:document.getElementById('wm-wage').value};
s.id=await fsAdd('payrollStaff',s);S.payrollStaff.push(s);
closeModal('wage-modal');renderWageStaff();buildPayInputs();buildCounterPeople();renderDash();showToast('Staff added ✓');
};
window.editWageStaff=function(id){
const s=S.payrollStaff.find(x=>x.id===id);if(!s)return;
document.getElementById('ew-id').value=id;
document.getElementById('ew-name').value=s.name;
document.getElementById('ew-role').value=s.role;
document.getElementById('ew-type').value=s.type;
document.getElementById('ew-wage').value=s.wage;
openModal('edit-wage-modal');
};
window.saveEditStaff=async function(){
const id=document.getElementById('ew-id').value;
const updates={name:document.getElementById('ew-name').value.trim(),role:document.getElementById('ew-role').value,type:document.getElementById('ew-type').value,wage:document.getElementById('ew-wage').value};
await fsUp('payrollStaff',id,updates);
const s=S.payrollStaff.find(x=>x.id===id);if(s)Object.assign(s,updates);
closeModal('edit-wage-modal');renderWageStaff();buildPayInputs();buildCounterPeople();showToast('Updated ✓');
};
function renderWageStaff(){
document.getElementById('wage-tbody').innerHTML=S.payrollStaff.length
?S.payrollStaff.map(s=>`<tr>
<td><strong>${s.name}</strong></td>
<td><span class="badge brole">${s.role}</span></td>
<td style="font-family:var(--font-mono);font-size:.72rem;color:var(--text2)">${s.type==='hourly'?'Hourly':'Daily'}</td>
<td style="font-family:var(--font-mono);font-size:.74rem">${s.type==='hourly'?fmt(s.wage)+'/hr':fmt(s.wage)+'/day'}</td>
<td style="display:flex;gap:4px">
<button class="btn bo bs" onclick="editWageStaff('${s.id}')">Edit</button>
<button class="btn br bs" onclick="delWageStaff('${s.id}')">✕</button>
</td></tr>`).join('')
:`<tr><td colspan="5" class="emp">// No staff yet</td></tr>`;
}
window.delWageStaff=async function(id){
if(!confirm('Remove this staff member?'))return;
await fsDel('payrollStaff',id);S.payrollStaff=S.payrollStaff.filter(s=>s.id!==id);
renderWageStaff();buildPayInputs();buildCounterPeople();renderDash();
};
function buildPayInputs(){
const c=document.getElementById('pay-inputs');
if(!S.payrollStaff.length){c.innerHTML='<p style="font-family:var(--font-mono);font-size:.67rem;color:var(--text3)">Add staff above first.</p>';return;}
c.innerHTML=S.payrollStaff.map(s=>`
<div class="pay-card">
<div class="pcname">${s.name}</div>
<div class="pcrole">${s.role} · ${s.type==='hourly'?fmt(s.wage)+'/hr':fmt(s.wage)+'/day'}</div>
<div class="fg">
<label>${s.type==='hourly'?'Hours (bi-weekly)':'Days worked'}</label>
<input type="number" id="pi-${s.id}" placeholder="0" step="${s.type==='hourly'?'0.5':'1'}" oninput="liveCalcPay('${s.id}','${s.wage}')">
</div>
<div class="pctot" id="pe-${s.id}">—</div>
</div>`).join('');
}
window.liveCalcPay=function(id,wage){
const qty=+document.getElementById('pi-'+id)?.value||0;
const el=document.getElementById('pe-'+id);
if(el)el.textContent=fmt(qty*(+wage||0));
};
window.calcAndSavePayroll=async function(){
const period=document.getElementById('pay-period').value;
if(!period){showToast('Select a period date');return;}
const entries=[];
for(const s of S.payrollStaff){
const qty=+document.getElementById('pi-'+s.id)?.value||0;
if(qty===0)continue;
const total=(qty*(+s.wage||0)).toFixed(2);
const rec={period,name:s.name,role:s.role,type:s.type,qty,wage:s.wage,total};
rec.id=await fsAdd('payrollHistory',rec);S.payrollHistory.push(rec);entries.push(rec);
}
if(!entries.length){showToast('No quantities entered');return;}
renderPayResults(entries);renderPayHist();renderDash();showToast('Payroll saved ✓');
};
function renderPayResults(entries){
const grand=entries.reduce((a,e)=>a+(+e.total||0),0);
document.getElementById('pay-grand').textContent=fmt(grand);
document.getElementById('pay-tbody').innerHTML=entries.map(e=>`<tr>
<td><strong>${e.name}</strong></td>
<td><span class="badge brole">${e.role}</span></td>
<td style="font-family:var(--font-mono);font-size:.72rem;color:var(--text2)">${e.type==='hourly'?'Hourly':'Daily'}</td>
<td style="font-family:var(--font-mono);font-size:.74rem">${e.qty} ${e.type==='hourly'?'hrs':'days'}</td>
<td style="font-family:var(--font-mono);font-size:.74rem">${e.type==='hourly'?fmt(e.wage)+'/hr':fmt(e.wage)+'/day'}</td>
<td style="color:var(--amber);font-weight:600;font-family:var(--font-mono)">${fmt(e.total)}</td>
</tr>`).join('');
const lines=['Name\tRole\tType\tQty\tWage\tTotal'];
entries.forEach(e=>lines.push(`${e.name}\t${e.role}\t${e.type==='hourly'?'Hourly':'Daily'}\t${e.qty}\t${fmtN(e.wage)}\t${fmtN(e.total)}`));
lines.push(`\t\t\t\tTOTAL\t${fmtN(grand)}`);
document.getElementById('pay-copy-text').textContent=lines.join('\n');
document.getElementById('pay-results-pn').style.display='block';
}
window.copyPayTable=function(){navigator.clipboard.writeText(document.getElementById('pay-copy-text').textContent);showToast('Copied ✓');};
window.selectCopyText=function(){
const el=document.getElementById('pay-copy-text');
const r=document.createRange();r.selectNodeContents(el);
const s=window.getSelection();s.removeAllRanges();s.addRange(r);
};
function renderPayHist(){
const sorted=[...S.payrollHistory].sort((a,b)=>new Date(b.period)-new Date(a.period));
document.getElementById('pay-hist-tbody').innerHTML=sorted.length
?sorted.map(p=>`<tr>
<td style="font-family:var(--font-mono);font-size:.72rem">${p.period}</td>
<td><strong>${p.name}</strong></td>
<td style="font-family:var(--font-mono);font-size:.72rem;color:var(--text2)">${p.type==='hourly'?'Hourly':'Daily'}</td>
<td style="font-family:var(--font-mono);font-size:.72rem">${p.qty} ${p.type==='hourly'?'hrs':'days'}</td>
<td style="font-family:var(--font-mono);font-size:.72rem">${p.type==='hourly'?fmt(p.wage)+'/hr':fmt(p.wage)+'/day'}</td>
<td style="color:var(--amber);font-weight:600;font-family:var(--font-mono)">${fmt(p.total)}</td>
<td><button class="btn br bs" onclick="delPayHist('${p.id}')">✕</button></td>
</tr>`).join('')
:`<tr><td colspan="7" class="emp">// No history yet</td></tr>`;
}
window.delPayHist=async function(id){
if(!confirm('Delete?'))return;
await fsDel('payrollHistory',id);S.payrollHistory=S.payrollHistory.filter(p=>p.id!==id);
renderPayHist();renderDash();
};
</script>
</body>
</html>
