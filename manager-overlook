function parseNode(node){
if(!node||typeof node!=='object')return;
Object.values(node).forEach(item=>{
if(typeof item!=='object')return;
const dateVal=item.date||item.reservationDate||item.day||item.Date||null;
const covers=parseInt(item.covers||item.guests||item.partySize||item.party_size||item.size||0)||0;
if(dateVal){
let d=String(dateVal);
if(/^\d{10,}$/.test(d))d=new Date(parseInt(d)).toISOString().slice(0,10);
if(!/^\d{4}-\d{2}-\d{2}$/.test(d)){const p=new Date(d);if(!isNaN(p))d=p.toISOString().slice(0,10);}
if(!byDate[d])byDate[d]={bookings:0,covers:0};
byDate[d].bookings++;
byDate[d].covers+=covers;
}
parseNode(item);
});
}
parseNode(raw);
S.reservations=byDate;
const n=Object.keys(byDate).length;
document.getElementById('res-sync-status').textContent=`${n} days synced`;
